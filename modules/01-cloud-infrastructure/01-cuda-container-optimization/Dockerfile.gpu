# Multi-stage Dockerfile for PyTorch + CUDA 12.x
# Stage 1: builder
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git curl ca-certificates python3-dev python3-pip python3-setuptools \
    libopenblas-dev libjpeg-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install PyTorch build wheels or the CPU wheels used for compilation if needed
# For typical usage, we'll install runtime wheels in the final stage via pip from the PyTorch index.

# Stage 2: runtime
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ca-certificates libopenblas3 libjpeg8 && \
    rm -rf /var/lib/apt/lists/*

# Install common ML runtime packages pinned to versions compatible with CUDA 12.x
# Adjust torch version if a newer cu121 wheel is available
RUN python3 -m pip install --no-cache-dir pip==23.3.1
RUN python3 -m pip install --no-cache-dir \
    "torch==2.2.0+cu121" --index-url https://download.pytorch.org/whl/cu121 \
    transformers sentence-transformers scikit-learn numpy scipy aiohttp

# Create a non-root user for security
RUN useradd --create-home --shell /bin/bash appuser
WORKDIR /home/appuser
USER appuser

COPY --chown=appuser:appuser verify_gpu.py ./

CMD ["python3", "verify_gpu.py"]
